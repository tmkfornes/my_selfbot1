# Get these from https://my.telegram.org
API_ID=
API_HASH=

# Prefix for in-chat commands (e.g. ".clock on")
PREFIX=.
SESSION_NAME=my_session

# Only needed on hosts with no persistent disk (e.g. Render). Generate once
# locally with generate_session.py, then paste the value here / into
# Render's environment variables. Leave blank when running locally.
SESSION_STRING=

# Token for your control bot, from @BotFather
BOT_TOKEN=

# Optional local SOCKS5 proxy (e.g. V2RayN). Leave blank to disable.
# Leave blank on Render — it's outside Iran, no proxy needed there.
PROXY_HOST=
PROXY_PORT=10808

# How often (seconds) the clock name updates. Keep >= 30 to avoid
# Telegram's rate limit on profile changes.
CLOCK_INTERVAL_SECONDS=60
CLOCK_TIMEZONE=Asia/Tehran

# `.ai` command — free key at https://openrouter.ai/keys. Leave blank to
# disable `.ai` entirely (rest of the bot works fine without it).
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_MODEL=qwen/qwen3-4b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=30
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_CALLS_PER_MINUTE=0

# Comma-separated usernames of bots to exclude from anti-delete tracking
# (e.g. your own control bot). Nothing is hardcoded in the source code.
ANTIDELETE_EXCLUDE_BOTS=
